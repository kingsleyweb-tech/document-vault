{
  "name": "document-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "companion": "npm --prefix companion start --",
    "test:companion": "npm --prefix companion test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-document-vault \"vitest run tests/rules\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/eng": "1.0.0",
    "firebase": "^12.18.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.34.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0",
    "utif": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^24.13.3",
    "@types/pg": "8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.11.0",
    "happy-dom": "^21.0.4",
    "pg": "8.16.3",
    "supabase": "2.121.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  }
}
