{
  "name": "document-vault-desktop",
  "productName": "Document Vault",
  "version": "1.3.2",
  "private": true,
  "description": "Document Vault for Windows, macOS and Linux.",
  "author": "Document Vault",
  "main": "src/main.cjs",
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "homepage": "https://documents-vault.vercel.app",
  "scripts": {
    "build:web": "node scripts/prepare.cjs",
    "start": "node scripts/prepare.cjs --if-missing && electron .",
    "test": "node --test \"test/**/*.test.cjs\"",
    "test:electron": "electron test/web-browser.electron.cjs",
    "dist:win": "node scripts/prepare.cjs && electron-builder --win --x64 --publish never",
    "dist:mac": "node scripts/prepare.cjs --mac && electron-builder --mac --arm64 --x64 --publish never",
    "dist:linux": "node scripts/prepare.cjs && electron-builder --linux --x64 --publish never"
  },
  "build": {
    "appId": "app.documentvault.desktop",
    "productName": "Document Vault",
    "copyright": "Document Vault",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "web/**/*",
      "companion/**/*",
      "build/icon.png"
    ],
    "asarUnpack": [
      "companion/**/*"
    ],
    "protocols": [
      {
        "name": "Document Vault",
        "schemes": [
          "documentvault"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Document-Vault-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Document-Vault-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Document-Vault-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Document Vault",
      "synopsis": "Private document workspace"
    },
    "appImage": {
      "artifactName": "Document-Vault-${version}-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "Document-Vault-${version}-amd64.${ext}"
    }
  }
}
