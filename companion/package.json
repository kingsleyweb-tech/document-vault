{
  "name": "document-vault-companion",
  "version": "1.3.1",
  "private": true,
  "description": "Local indexing service that lets the Document Vault web app search and open files on this computer.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "document-vault-companion": "bin/companion.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bin/companion.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "check:launcher": "node scripts/check-launcher.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@tesseract.js-data/eng": "1.0.0",
    "heic-decode": "2.1.0",
    "jszip": "3.10.1",
    "mammoth": "1.12.1",
    "pdfjs-dist": "6.2.108",
    "tesseract.js": "7.0.0",
    "word-extractor": "1.0.4"
  }
}
